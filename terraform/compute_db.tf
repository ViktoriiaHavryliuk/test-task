############################################################################
# compute_db.tf — MySQL on EC2 in the data tier, from a pre-baked AMI
#
# No public IP, no internet route, no endpoints, no egress rule. The AMI
# already contains the database server, so nothing is downloaded at boot;
# user data only creates the application account.
#
# POC shortcut: the application password is generated by Terraform and
# passed to both instances in user data, which anyone with
# ec2:DescribeInstanceAttribute can read. Replace with Secrets Manager or
# Parameter Store (needs an interface endpoint) before production.
############################################################################

resource "random_password" "db_app" {
  length  = 24
  special = false
}

resource "aws_instance" "db" {
  ami                         = var.db_ami_id
  instance_type               = local.db_instance_type
  subnet_id                   = aws_subnet.data[var.availability_zones[0]].id
  vpc_security_group_ids      = [aws_security_group.db.id]
  associate_public_ip_address = false

  metadata_options {
    http_endpoint = "enabled"
    http_tokens   = "required"
  }

  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }

  user_data = templatefile("${path.module}/templates/db-user-data.sh", {
    db_password = random_password.db_app.result
  })

  tags = { Name = "${local.name}-db", Tier = "data" }
}
